{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:memorytree:schema:v1:repo",
  "title": "MemoryTree repository metadata (memory.yaml)",
  "description": "Validates the parsed YAML object of memory.yaml. Format version 1.",
  "type": "object",
  "required": ["schema", "format_version", "repo_id", "created_at"],
  "properties": {
    "schema": {
      "const": "memorytree.repo/v1"
    },
    "format_version": {
      "type": "integer",
      "const": 1
    },
    "repo_id": {
      "$ref": "#/$defs/uuidv7"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "default_sensitivity": {
      "type": "string",
      "enum": ["public", "internal", "private"],
      "default": "private"
    },
    "description": {
      "type": "string",
      "maxLength": 500
    }
  },
  "additionalProperties": true,
  "$defs": {
    "uuidv7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$",
      "description": "RFC 3339 timestamp; UTC with Z is recommended."
    }
  }
}
