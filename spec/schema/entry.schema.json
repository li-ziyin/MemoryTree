{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:memorytree:schema:v1:entry",
  "title": "MemoryTree entry (memories/*.md)",
  "description": "Validates the parsed YAML frontmatter of a memory entry. The Markdown body is not validated by this schema.",
  "type": "object",
  "required": [
    "schema",
    "id",
    "node",
    "type",
    "status",
    "sensitivity",
    "title",
    "summary",
    "tags_delta",
    "source",
    "supersedes",
    "superseded_by",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema": {
      "const": "memorytree.entry/v1"
    },
    "id": {
      "$ref": "#/$defs/uuidv7"
    },
    "node": {
      "$ref": "#/$defs/uuidv7"
    },
    "type": {
      "type": "string",
      "enum": ["user", "feedback", "project", "reference"]
    },
    "status": {
      "type": "string",
      "enum": ["active", "superseded", "deprecated", "draft"]
    },
    "sensitivity": {
      "type": "string",
      "enum": ["public", "internal", "private"]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "Primary retrieval text; 280 characters or fewer is recommended."
    },
    "tags_delta": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 32
      },
      "uniqueItems": true,
      "maxItems": 64
    },
    "source": {
      "type": "object",
      "required": ["agent", "kind"],
      "properties": {
        "agent": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "kind": {
          "type": "string",
          "enum": ["conversation", "document", "manual", "import"]
        },
        "session": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "captured_at": {
          "$ref": "#/$defs/timestamp"
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?![A-Za-z]:[\\\\/]|/).+$",
          "description": "Relative path or URL. Local absolute paths are forbidden."
        }
      },
      "additionalProperties": true
    },
    "supersedes": {
      "type": "array",
      "items": { "$ref": "#/$defs/uuidv7" },
      "uniqueItems": true,
      "maxItems": 100
    },
    "superseded_by": {
      "anyOf": [
        { "$ref": "#/$defs/uuidv7" },
        { "type": "null" }
      ]
    },
    "related": {
      "type": "array",
      "items": { "$ref": "#/$defs/uuidv7" },
      "uniqueItems": true,
      "maxItems": 100,
      "default": []
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "updated_at": {
      "$ref": "#/$defs/timestamp"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "superseded" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "superseded_by": { "$ref": "#/$defs/uuidv7" }
        }
      },
      "else": {
        "properties": {
          "superseded_by": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "supersedes": { "type": "array", "minItems": 1 }
        },
        "required": ["supersedes"]
      },
      "then": {
        "properties": {
          "status": { "const": "active" }
        }
      }
    }
  ],
  "additionalProperties": true,
  "$defs": {
    "uuidv7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$",
      "description": "RFC 3339 timestamp; UTC with Z is recommended."
    }
  }
}
